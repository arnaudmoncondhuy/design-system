{#
    Étend le gabarit de l'application, et non directement le squelette du paquet : c'est
    l'application qui pose ses scripts, et la vitrine en a besoin — sans eux, le menu de palette,
    le menu déroulant et la fenêtre modale sont inertes.

    La chaîne est donc : cette page → base.html.twig de l'application → @DesignSystem/layout.

    Remplir le bloc `sidebar` fait passer la charpente en deux colonnes : la page se sert
    d'elle-même de démonstration.
#}
{% extends 'base.html.twig' %}

{% set tones = ['neutral', 'accent', 'success', 'warning', 'danger', 'info'] %}
{% set sections = {
    tokens: 'styleguide.section.tokens',
    typography: 'styleguide.section.typography',
    spacing: 'styleguide.section.spacing',
    shapes: 'styleguide.section.shapes',
    motion: 'styleguide.section.motion',
    measures: 'styleguide.section.measures',
    buttons: 'styleguide.section.buttons',
    badges: 'styleguide.section.badges',
    cards: 'styleguide.section.cards',
    dashboard: 'styleguide.section.dashboard',
    forms: 'styleguide.section.forms',
    checks: 'styleguide.section.checks',
    tables: 'styleguide.section.tables',
    lists: 'styleguide.section.lists',
    alerts: 'styleguide.section.alerts',
    detail: 'styleguide.section.detail',
    steps: 'styleguide.section.steps',
    navigation: 'styleguide.section.navigation',
    layout: 'styleguide.section.layout',
    disclosure: 'styleguide.section.disclosure',
    topbar: 'styleguide.section.topbar',
    modal: 'styleguide.section.modal',
} %}

{% block title %}{{ 'styleguide.title'|trans({}, 'design_system') }}{% endblock %}

{% block brand_label %}{{ 'styleguide.title'|trans({}, 'design_system') }}{% endblock %}

{# La feuille de la vitrine ne sert qu'à cette page : elle ne part pas dans le lot commun. #}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/designsystem/styleguide.css') }}">
{% endblock %}

{% block sidebar %}
    <nav class="app-nav" data-orientation="vertical" aria-label="{{ 'styleguide.sidebar.label'|trans({}, 'design_system') }}">
        {% for anchor, label in sections %}
            <a class="app-nav-item" href="#{{ anchor }}">{{ label|trans({}, 'design_system') }}</a>
        {% endfor %}
    </nav>
    {# Ce qui reste au bas du menu quand les liens défilent au-dessus. #}
    <div class="app-sidebar-footer app-row">
        <span class="app-avatar">AM</span>
        <span class="app-muted">{{ 'styleguide.sidebar.footer'|trans({}, 'design_system') }}</span>
    </div>
{% endblock %}

{% block body %}
    <div class="app-stack">
        <div>
            <h1>{{ 'styleguide.title'|trans({}, 'design_system') }}</h1>
            <p class="app-muted">{{ 'styleguide.intro'|trans({}, 'design_system') }}</p>
        </div>

        <section class="app-sg-section" id="tokens">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.tokens'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.tokens.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-stack">
                <div class="app-sg-palette">
                    {% for token in ['app-bg', 'app-surface', 'app-raised', 'app-hover', 'app-ink', 'app-ink-soft', 'app-ink-muted', 'app-ink-inverse', 'app-line', 'app-line-strong', 'app-line-control', 'app-backdrop'] %}
                        <span class="app-sg-swatch" style="--app-sg-color: var(--{{ token }})">--{{ token }}</span>
                    {% endfor %}
                </div>
                {# Les cinq jetons d'un ton, ton par ton : c'est la ligne entière qu'une palette
                   déplace, ou aucune de ses cases. #}
                {% for tone in tones %}
                    <div class="app-sg-palette">
                        {% for suffix in ['', '-hover', '-soft', '-ink'] %}
                            <span class="app-sg-swatch" style="--app-sg-color: var(--app-{{ tone }}{{ suffix }})">--app-{{ tone }}{{ suffix }}</span>
                        {% endfor %}
                        <span class="app-sg-swatch" style="--app-sg-color: var(--app-on-{{ tone }})">--app-on-{{ tone }}</span>
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="app-sg-section" id="typography">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.typography'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.typography.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-sg-demo" data-stacked>
                {% for token in ['app-text-2xl', 'app-text-xl', 'app-text-lg', 'app-text', 'app-text-sm', 'app-text-xs'] %}
                    <p class="app-sg-type" style="font-size: var(--{{ token }})">
                        <span>{{ 'styleguide.typography.sample'|trans({}, 'design_system') }}</span>
                        <code>--{{ token }}</code>
                    </p>
                {% endfor %}
                {% for token, label in {
                    'app-weight-medium': 'styleguide.weight.medium',
                    'app-weight-semibold': 'styleguide.weight.semibold',
                    'app-weight-bold': 'styleguide.weight.bold',
                    'app-weight-heavy': 'styleguide.weight.heavy',
                } %}
                    <p class="app-sg-type" style="font-weight: var(--{{ token }})">
                        <span>{{ label|trans({}, 'design_system') }}</span>
                        <code>--{{ token }}</code>
                    </p>
                {% endfor %}
                {% for token, label in {
                    'app-font': 'styleguide.font.sans',
                    'app-font-mono': 'styleguide.font.mono',
                } %}
                    <p class="app-sg-type" style="font-family: var(--{{ token }})">
                        <span>{{ label|trans({}, 'design_system') }}</span>
                        <code>--{{ token }}</code>
                    </p>
                {% endfor %}
                {# L'exemple porte l'interligne qu'il nomme : il lui faut donc deux lignes pour
                   que l'écart se voie. #}
                {% for token, label in {
                    'app-leading': 'styleguide.leading.normal',
                    'app-leading-tight': 'styleguide.leading.tight',
                    'app-leading-none': 'styleguide.leading.none',
                } %}
                    <p class="app-sg-setting" style="line-height: var(--{{ token }})">
                        <span>{{ label|trans({}, 'design_system') }}</span>
                        <code>--{{ token }}</code>
                    </p>
                {% endfor %}
                {% for token, label in {
                    'app-font-size': 'styleguide.measures.font_size',
                    'app-link-decoration': 'styleguide.measures.link_decoration',
                } %}
                    <p class="app-sg-setting">
                        <span>{{ label|trans({}, 'design_system') }}</span>
                        <code>--{{ token }}</code>
                    </p>
                {% endfor %}
            </div>
        </section>

        <section class="app-sg-section" id="spacing">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.spacing'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.spacing.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-sg-demo" data-stacked>
                <p class="app-sg-setting">
                    <span>{{ 'styleguide.spacing.gap'|trans({}, 'design_system') }}</span>
                    <code>--app-gap</code>
                </p>
                {# Chaque barre est large de l'espacement qu'elle nomme : l'échelle se lit d'un
                   coup d'œil, et une valeur qui sortirait du rythme se verrait. #}
                {% for token in ['app-gap', 'app-space-2xs', 'app-space-xs', 'app-space-sm', 'app-space-md', 'app-space-lg', 'app-space-xl', 'app-space-2xl', 'app-space-3xl'] %}
                    <span class="app-sg-ruler" style="--app-sg-size: var(--{{ token }})">--{{ token }}</span>
                {% endfor %}
            </div>
        </section>

        <section class="app-sg-section" id="shapes">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.shapes'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.shapes.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-stack">
                <h3>{{ 'styleguide.shapes.radius'|trans({}, 'design_system') }}</h3>
                <div class="app-sg-palette">
                    {% for token in ['app-radius', 'app-radius-ui', 'app-radius-pill'] %}
                        <span class="app-sg-shape" style="--app-sg-radius: var(--{{ token }})">--{{ token }}</span>
                    {% endfor %}
                </div>
                <h3>{{ 'styleguide.shapes.shadow'|trans({}, 'design_system') }}</h3>
                <div class="app-sg-palette">
                    {% for token in ['app-shadow-sm', 'app-shadow', 'app-shadow-pop', 'app-shadow-focus'] %}
                        <span class="app-sg-shape" style="--app-sg-shadow: var(--{{ token }})">--{{ token }}</span>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="motion">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.motion'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.motion.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-sg-demo" data-stacked>
                {# Atteignables au clavier : la démonstration ne peut pas dépendre du pointeur. #}
                {% for token in ['app-speed', 'app-speed-slow'] %}
                    <span class="app-sg-motion" tabindex="0" style="--app-sg-duration: var(--{{ token }})">--{{ token }}</span>
                {% endfor %}
                <p class="app-sg-setting">
                    <span>{{ 'styleguide.motion.ease'|trans({}, 'design_system') }}</span>
                    <code>--app-ease</code>
                </p>
            </div>
        </section>

        <section class="app-sg-section" id="measures">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.measures'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.measures.hint'|trans({}, 'design_system') }}</span>
            </div>
            {# Une largeur de page ou un ordre d'empilement n'a pas d'échantillon : ce qui les
               rend trouvables est leur nom, et la phrase qui dit ce qu'ils gouvernent. #}
            <div class="app-sg-demo" data-stacked>
                {% for token, label in {
                    'app-content-width': 'styleguide.measures.content_width',
                    'app-content-narrow': 'styleguide.measures.content_narrow',
                    'app-sidebar-width': 'styleguide.measures.sidebar_width',
                    'app-topbar-height': 'styleguide.measures.topbar_height',
                    'app-focus-width': 'styleguide.measures.focus_width',
                    'app-focus-offset': 'styleguide.measures.focus_offset',
                    'app-z-sticky': 'styleguide.measures.z_sticky',
                    'app-z-dropdown': 'styleguide.measures.z_dropdown',
                    'app-z-skip': 'styleguide.measures.z_skip',
                } %}
                    <p class="app-sg-setting">
                        <span>{{ label|trans({}, 'design_system') }}</span>
                        <code>--{{ token }}</code>
                    </p>
                {% endfor %}
            </div>
        </section>

        <section class="app-sg-section" id="buttons">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.buttons'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.buttons.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-stack">
                {# Les dix-huit combinaisons que la grammaire permet, sur une seule grille : une
                   palette qui en abîmerait une se voit ici et nulle part ailleurs. #}
                <div class="app-sg-matrix">
                    <span></span>
                    {% for variant in ['solid', 'subtle', 'ghost'] %}
                        <span class="app-sg-matrix-head">{{ ('styleguide.variant.' ~ variant)|trans({}, 'design_system') }}</span>
                    {% endfor %}
                    {% for tone in tones %}
                        <span class="app-sg-matrix-row">{{ tone }}</span>
                        {% for variant in ['solid', 'subtle', 'ghost'] %}
                            <span>
                                <button type="button" class="app-btn" data-tone="{{ tone }}"{% if variant != 'solid' %} data-variant="{{ variant }}"{% endif %}>
                                    {{ ('styleguide.tone.' ~ tone)|trans({}, 'design_system') }}
                                </button>
                            </span>
                        {% endfor %}
                    {% endfor %}
                </div>

                <div class="app-sg-demo">
                    <button type="button" class="app-btn" data-size="sm">{{ 'styleguide.size.small'|trans({}, 'design_system') }}</button>
                    <button type="button" class="app-btn">{{ 'styleguide.size.normal'|trans({}, 'design_system') }}</button>
                    <button type="button" class="app-btn" data-size="lg">{{ 'styleguide.size.large'|trans({}, 'design_system') }}</button>
                </div>
                <div class="app-sg-demo">
                    <button type="button" class="app-btn" disabled>{{ 'styleguide.state.disabled'|trans({}, 'design_system') }}</button>
                    <button type="button" class="app-btn" aria-busy="true">{{ 'styleguide.state.busy'|trans({}, 'design_system') }}</button>
                    <button type="button" class="app-btn" data-variant="subtle" data-icon aria-label="{{ 'styleguide.state.icon'|trans({}, 'design_system') }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <div class="app-sg-demo" data-stacked>
                    <button type="button" class="app-btn" data-block>{{ 'styleguide.state.block'|trans({}, 'design_system') }}</button>
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="badges">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.badges'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.badges.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-stack">
                <div class="app-sg-demo">
                    <span class="app-badge">{{ 'styleguide.tone.none'|trans({}, 'design_system') }}</span>
                    {% for tone in tones %}
                        <span class="app-badge" data-tone="{{ tone }}">{{ ('styleguide.tone.' ~ tone)|trans({}, 'design_system') }}</span>
                    {% endfor %}
                </div>
                <div class="app-sg-demo">
                    <span class="app-badge" data-variant="solid">{{ 'styleguide.tone.none'|trans({}, 'design_system') }}</span>
                    {% for tone in tones %}
                        <span class="app-badge" data-variant="solid" data-tone="{{ tone }}">{{ ('styleguide.tone.' ~ tone)|trans({}, 'design_system') }}</span>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="cards">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.cards'|trans({}, 'design_system') }}</h2>
            </div>
            <div class="app-grid">
                <article class="app-card">
                    <div>
                        <p class="app-card-title">{{ 'styleguide.card.title'|trans({}, 'design_system') }}</p>
                        <p class="app-card-meta">{{ 'styleguide.card.meta'|trans({}, 'design_system') }}</p>
                    </div>
                    <p>{{ 'styleguide.card.body'|trans({}, 'design_system') }}</p>
                    <div class="app-card-footer">
                        <button type="button" class="app-btn" data-size="sm">{{ 'action.save'|trans({}, 'design_system') }}</button>
                        <button type="button" class="app-btn" data-variant="ghost" data-size="sm">{{ 'action.cancel'|trans({}, 'design_system') }}</button>
                    </div>
                </article>
                <article class="app-card" data-interactive>
                    <div class="app-row">
                        <span class="app-avatar">AM</span>
                        <div>
                            <p class="app-card-title">{{ 'styleguide.card.interactive'|trans({}, 'design_system') }}</p>
                            <p class="app-card-meta">{{ 'styleguide.card.interactive_meta'|trans({}, 'design_system') }}</p>
                        </div>
                    </div>
                </article>
                <article class="app-card" data-tone="danger">
                    <div class="app-row">
                        <span class="app-avatar" data-tone="danger">!</span>
                        <div>
                            <p class="app-card-title">{{ 'styleguide.card.toned'|trans({}, 'design_system') }}</p>
                            <p class="app-card-meta">{{ 'styleguide.card.toned_meta'|trans({}, 'design_system') }}</p>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <section class="app-sg-section" id="dashboard">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.dashboard'|trans({}, 'design_system') }}</h2>
            </div>
            <div class="app-stack">
                <div class="app-grid" data-cols="4">
                    <div class="app-stat">
                        <p class="app-stat-label">{{ 'styleguide.stat.open'|trans({}, 'design_system') }}</p>
                        <p class="app-stat-value">128</p>
                        <p class="app-stat-hint">{{ 'styleguide.stat.hint'|trans({}, 'design_system') }}</p>
                    </div>
                    <div class="app-stat" data-tone="success">
                        <p class="app-stat-label">{{ 'styleguide.stat.closed'|trans({}, 'design_system') }}</p>
                        <p class="app-stat-value">96</p>
                        <p class="app-stat-hint">{{ 'styleguide.stat.hint'|trans({}, 'design_system') }}</p>
                    </div>
                    <div class="app-stat" data-tone="danger">
                        <p class="app-stat-label">{{ 'styleguide.stat.late'|trans({}, 'design_system') }}</p>
                        <p class="app-stat-value">4</p>
                        <p class="app-stat-hint">{{ 'styleguide.stat.hint'|trans({}, 'design_system') }}</p>
                    </div>
                </div>
                <div class="app-field">
                    <span class="app-field-label" id="sg-progress-label">{{ 'styleguide.progress.label'|trans({}, 'design_system') }}</span>
                    {# Le rôle et les trois valeurs se déclarent en ARIA : la largeur du remplissage
                       ne dit rien à qui n'a pas l'écran sous les yeux. #}
                    <div class="app-progress" style="--app-progress: 62%"
                         role="progressbar" aria-labelledby="sg-progress-label"
                         aria-valuenow="62" aria-valuemin="0" aria-valuemax="100"></div>
                    <div class="app-progress" data-tone="warning" style="--app-progress: 24%"
                         role="progressbar" aria-label="{{ 'styleguide.progress.late'|trans({}, 'design_system') }}"
                         aria-valuenow="24" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="forms">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.forms'|trans({}, 'design_system') }}</h2>
            </div>
            <div class="app-sg-demo" data-stacked>
                <div class="app-field">
                    <label class="app-field-label" for="sg-text">{{ 'styleguide.form.text'|trans({}, 'design_system') }}</label>
                    <input id="sg-text" type="text" placeholder="{{ 'styleguide.form.placeholder'|trans({}, 'design_system') }}"
                           aria-describedby="sg-text-hint">
                    <span class="app-field-hint" id="sg-text-hint">{{ 'styleguide.form.hint'|trans({}, 'design_system') }}</span>
                </div>
                {# Le champ et son bouton n'en font qu'un : une seule commande à l'œil, deux
                   éléments au clavier, chacun atteignable. #}
                <div class="app-field">
                    <label class="app-field-label" for="sg-search">{{ 'styleguide.form.search'|trans({}, 'design_system') }}</label>
                    <div class="app-input-group">
                        <input id="sg-search" type="search" placeholder="{{ 'styleguide.form.search_placeholder'|trans({}, 'design_system') }}">
                        <button type="button" class="app-btn">{{ 'styleguide.form.search_action'|trans({}, 'design_system') }}</button>
                    </div>
                </div>
                {# `size` dit combien de caractères le champ porte, et c'est lui qui fixe alors la
                   largeur : un code à six chiffres n'a pas à s'étendre sur toute la ligne. #}
                <div class="app-field">
                    <label class="app-field-label" for="sg-code">{{ 'styleguide.form.code'|trans({}, 'design_system') }}</label>
                    <input id="sg-code" type="text" size="6" inputmode="numeric" value="481203">
                </div>
                <div class="app-field">
                    <label class="app-field-label" for="sg-select">{{ 'styleguide.form.select'|trans({}, 'design_system') }}</label>
                    <select id="sg-select">
                        <option>{{ 'styleguide.form.option_one'|trans({}, 'design_system') }}</option>
                        <option>{{ 'styleguide.form.option_two'|trans({}, 'design_system') }}</option>
                    </select>
                </div>
                <div class="app-field" data-invalid>
                    <label class="app-field-label" for="sg-invalid">{{ 'styleguide.form.invalid'|trans({}, 'design_system') }}</label>
                    {# `aria-invalid` porte le refus, `aria-describedby` rattache le motif au
                       champ : sans lui, un lecteur d'écran annonce l'erreur sans dire de quoi
                       elle parle. Le filet rouge ne suffit pas — il ne se voit pas de tous. #}
                    <input id="sg-invalid" type="email" value="arnaud@"
                           aria-invalid="true" aria-describedby="sg-invalid-error">
                    <span class="app-field-error" id="sg-invalid-error">{{ 'styleguide.form.error'|trans({}, 'design_system') }}</span>
                </div>
                <div class="app-field">
                    <label class="app-field-label" for="sg-disabled">{{ 'styleguide.form.disabled'|trans({}, 'design_system') }}</label>
                    <input id="sg-disabled" type="text" value="—" disabled>
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="checks">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.checks'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.checks.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-sg-demo" data-stacked>
                {# Le <label> contient sa commande : le texte devient cliquable, et il n'y a
                   aucun identifiant à inventer pour les rattacher l'un à l'autre. #}
                <label class="app-check">
                    <input type="checkbox" checked>
                    <span>{{ 'styleguide.check.notify'|trans({}, 'design_system') }}</span>
                </label>
                <label class="app-check">
                    <input type="checkbox">
                    <span>{{ 'styleguide.check.long'|trans({}, 'design_system') }}</span>
                </label>
                <label class="app-check">
                    <input type="checkbox" disabled>
                    <span>{{ 'styleguide.check.locked'|trans({}, 'design_system') }}</span>
                </label>

                {# Un groupe de boutons radio est une question : <fieldset> la pose, <legend> la
                   dit, et un lecteur d'écran la rappelle à chaque réponse. #}
                <fieldset class="app-field">
                    <legend class="app-field-label">{{ 'styleguide.check.frequency'|trans({}, 'design_system') }}</legend>
                    <label class="app-check">
                        <input type="radio" name="sg-frequency" checked>
                        <span>{{ 'styleguide.check.daily'|trans({}, 'design_system') }}</span>
                    </label>
                    <label class="app-check">
                        <input type="radio" name="sg-frequency">
                        <span>{{ 'styleguide.check.weekly'|trans({}, 'design_system') }}</span>
                    </label>
                </fieldset>

                <label class="app-check" data-variant="switch">
                    <input type="checkbox" checked>
                    <span>{{ 'styleguide.check.offline'|trans({}, 'design_system') }}</span>
                </label>
                <label class="app-check" data-variant="switch" data-tone="danger">
                    <input type="checkbox" checked>
                    <span>{{ 'styleguide.check.risky'|trans({}, 'design_system') }}</span>
                </label>

                {# Quelques réponses exclusives, toutes visibles : ce sont des boutons radio,
                   avec le clavier et l'annonce qui vont avec. #}
                <fieldset class="app-field">
                    <legend class="app-field-label">{{ 'styleguide.segmented.label'|trans({}, 'design_system') }}</legend>
                    <div class="app-segmented">
                        {% for value, label in {all: 'styleguide.segmented.all', mine: 'styleguide.segmented.mine', archived: 'styleguide.segmented.archived'} %}
                            <label>
                                <input type="radio" name="sg-scope"{{ value == 'all' ? ' checked' : '' }}>
                                <span>{{ label|trans({}, 'design_system') }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
            </div>
        </section>

        <section class="app-sg-section" id="tables">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.tables'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.tables.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-stack">
                <div class="app-table-wrap">
                    <table class="app-table">
                        <thead>
                            <tr>
                                {# `aria-sort` dit dans quel sens la colonne est rangée ; la flèche
                                   ne fait que le montrer, et reste muette. #}
                                <th scope="col" aria-sort="ascending">
                                    <a class="app-table-sort" href="#">{{ 'styleguide.table.name'|trans({}, 'design_system') }}</a>
                                </th>
                                <th scope="col">
                                    <a class="app-table-sort" href="#">{{ 'styleguide.table.status'|trans({}, 'design_system') }}</a>
                                </th>
                                <th scope="col">
                                    <a class="app-table-sort" href="#">{{ 'styleguide.table.date'|trans({}, 'design_system') }}</a>
                                </th>
                                <th scope="col" data-actions>
                                    <span class="app-sr-only">{{ 'styleguide.table.actions'|trans({}, 'design_system') }}</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>{{ 'styleguide.table.row_one'|trans({}, 'design_system') }}</td>
                                <td><span class="app-badge" data-tone="success">{{ 'styleguide.tone.success'|trans({}, 'design_system') }}</span></td>
                                <td class="app-muted">12/03/2026</td>
                                <td data-actions>
                                    <button type="button" class="app-btn" data-variant="ghost" data-size="sm">{{ 'action.edit'|trans({}, 'design_system') }}</button>
                                </td>
                            </tr>
                            {# La ligne retenue se marque par `aria-selected`, que le lecteur
                               d'écran annonce déjà : la teinte ne fait que le doubler. #}
                            <tr aria-selected="true">
                                <td>{{ 'styleguide.table.row_two'|trans({}, 'design_system') }}</td>
                                <td><span class="app-badge" data-tone="warning">{{ 'styleguide.tone.warning'|trans({}, 'design_system') }}</span></td>
                                <td class="app-muted">28/05/2026</td>
                                <td data-actions>
                                    <button type="button" class="app-btn" data-variant="ghost" data-size="sm" data-tone="danger">{{ 'action.delete'|trans({}, 'design_system') }}</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <nav aria-label="{{ 'styleguide.pagination.label'|trans({}, 'design_system') }}">
                    <ol class="app-pagination">
                        <li><a class="app-pagination-item" href="#" aria-disabled="true">{{ 'styleguide.pagination.previous'|trans({}, 'design_system') }}</a></li>
                        <li><a class="app-pagination-item" href="#" aria-current="page">1</a></li>
                        <li><a class="app-pagination-item" href="#">2</a></li>
                        <li><a class="app-pagination-item" href="#">3</a></li>
                        <li><span class="app-pagination-gap">…</span></li>
                        <li><a class="app-pagination-item" href="#">12</a></li>
                        <li><a class="app-pagination-item" href="#">{{ 'styleguide.pagination.next'|trans({}, 'design_system') }}</a></li>
                    </ol>
                </nav>
            </div>
        </section>

        <section class="app-sg-section" id="lists">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.lists'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.list.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-card">
                <ul class="app-list">
                    {% for entry in ['one', 'two', 'three'] %}
                        <li class="app-list-item">
                            <div>
                                <p class="app-list-title">{{ ('styleguide.list.' ~ entry)|trans({}, 'design_system') }}</p>
                                <p class="app-list-meta">{{ 'styleguide.list.meta'|trans({}, 'design_system') }}</p>
                            </div>
                            <button type="button" class="app-btn" data-variant="subtle" data-tone="danger" data-size="sm">
                                {{ 'action.delete'|trans({}, 'design_system') }}
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        <section class="app-sg-section" id="alerts">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.alerts'|trans({}, 'design_system') }}</h2>
            </div>
            <div class="app-stack" style="--app-stack-gap: var(--app-space-sm)">
                <p class="app-alert">{{ 'styleguide.alert.neutral'|trans({}, 'design_system') }}</p>
                {% for tone in ['info', 'success', 'warning', 'danger'] %}
                    <p class="app-alert" data-tone="{{ tone }}" role="status">{{ ('styleguide.alert.' ~ tone)|trans({}, 'design_system') }}</p>
                {% endfor %}
            </div>
        </section>

        <section class="app-sg-section" id="detail">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.detail'|trans({}, 'design_system') }}</h2>
            </div>
            <div class="app-grid" data-cols="2">
                <div class="app-card">
                    <dl class="app-dl">
                        <dt>{{ 'styleguide.detail.reference'|trans({}, 'design_system') }}</dt>
                        <dd>DOS-2026-128</dd>
                        <dt>{{ 'styleguide.detail.owner'|trans({}, 'design_system') }}</dt>
                        <dd>Arnaud Moncondhuy</dd>
                        <dt>{{ 'styleguide.detail.status'|trans({}, 'design_system') }}</dt>
                        <dd><span class="app-badge" data-tone="accent">{{ 'styleguide.tone.accent'|trans({}, 'design_system') }}</span></dd>
                        <dt>{{ 'styleguide.detail.created'|trans({}, 'design_system') }}</dt>
                        <dd>12/03/2026</dd>
                    </dl>
                </div>
                <div class="app-empty">
                    <p class="app-empty-title">{{ 'styleguide.empty.title'|trans({}, 'design_system') }}</p>
                    <p>{{ 'styleguide.empty.body'|trans({}, 'design_system') }}</p>
                    <button type="button" class="app-btn" data-size="sm">{{ 'styleguide.empty.action'|trans({}, 'design_system') }}</button>
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="steps">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.steps'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.steps.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-sg-demo" data-stacked>
                <ol class="app-steps">
                    <li class="app-steps-item" data-done>{{ 'styleguide.steps.one'|trans({}, 'design_system') }}</li>
                    <li class="app-steps-item" aria-current="step">{{ 'styleguide.steps.two'|trans({}, 'design_system') }}</li>
                    <li class="app-steps-item">{{ 'styleguide.steps.three'|trans({}, 'design_system') }}</li>
                </ol>
            </div>
        </section>

        <section class="app-sg-section" id="navigation">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.navigation'|trans({}, 'design_system') }}</h2>
            </div>
            <div class="app-stack">
                <nav class="app-sg-demo" aria-label="{{ 'styleguide.nav.label'|trans({}, 'design_system') }}">
                    <div class="app-nav">
                        <a class="app-nav-item" href="#navigation" aria-current="page">{{ 'styleguide.nav.overview'|trans({}, 'design_system') }}</a>
                        <a class="app-nav-item" href="#navigation">{{ 'styleguide.nav.files'|trans({}, 'design_system') }}</a>
                        <a class="app-nav-item" href="#navigation">{{ 'styleguide.nav.settings'|trans({}, 'design_system') }}</a>
                    </div>
                </nav>

                <nav aria-label="{{ 'styleguide.breadcrumb.label'|trans({}, 'design_system') }}">
                    <ol class="app-breadcrumb">
                        <li><a href="#navigation">{{ 'styleguide.breadcrumb.home'|trans({}, 'design_system') }}</a></li>
                        <li><a href="#navigation">{{ 'styleguide.breadcrumb.section'|trans({}, 'design_system') }}</a></li>
                        <li><span aria-current="page">{{ 'styleguide.breadcrumb.current'|trans({}, 'design_system') }}</span></li>
                    </ol>
                </nav>

                <nav class="app-tabs">
                    <a class="app-tabs-item" href="#navigation" aria-current="page">{{ 'styleguide.tab.one'|trans({}, 'design_system') }}</a>
                    <a class="app-tabs-item" href="#navigation">{{ 'styleguide.tab.two'|trans({}, 'design_system') }}</a>
                    <a class="app-tabs-item" href="#navigation">{{ 'styleguide.tab.three'|trans({}, 'design_system') }}</a>
                </nav>
            </div>
        </section>

        <section class="app-sg-section" id="layout">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.layout'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.layout.hint'|trans({}, 'design_system') }}</span>
            </div>
            {# La colonne de gauche de cette page en est déjà une ; celle-ci n'est là que pour la
               montrer de près, avec ses états. #}
            <div class="app-sg-shell">
                <div class="app-sidebar">
                    <nav class="app-nav" data-orientation="vertical" aria-label="{{ 'styleguide.layout.example'|trans({}, 'design_system') }}">
                        <a class="app-nav-item" href="#layout" aria-current="page">{{ 'styleguide.nav.overview'|trans({}, 'design_system') }}</a>
                        <a class="app-nav-item" href="#layout">{{ 'styleguide.nav.files'|trans({}, 'design_system') }}</a>
                        <a class="app-nav-item" href="#layout">{{ 'styleguide.nav.settings'|trans({}, 'design_system') }}</a>
                    </nav>
                </div>
                <div class="app-sg-shell-main">
                    <p class="app-muted">{{ 'styleguide.layout.body'|trans({}, 'design_system') }}</p>
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="disclosure">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.disclosure'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.disclosure.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-stack">
                <div class="app-sg-demo">
                    <details class="app-menu" data-controller="menu" data-align="start">
                        <summary class="app-btn" data-variant="subtle">{{ 'styleguide.menu.open'|trans({}, 'design_system') }}</summary>
                        <div class="app-menu-panel">
                            <a class="app-menu-item" href="#disclosure">{{ 'styleguide.menu.profile'|trans({}, 'design_system') }}</a>
                            <a class="app-menu-item" href="#disclosure">{{ 'styleguide.menu.settings'|trans({}, 'design_system') }}</a>
                            <hr class="app-menu-separator">
                            <button type="button" class="app-menu-item" data-tone="danger">{{ 'styleguide.menu.logout'|trans({}, 'design_system') }}</button>
                        </div>
                    </details>
                </div>

                {# Le même `name` sur les deux : le navigateur n'en laisse qu'un ouvert. #}
                <div class="app-stack" style="--app-stack-gap: var(--app-space-sm)">
                    <details class="app-accordion" name="sg-accordion" open>
                        <summary>{{ 'styleguide.accordion.one'|trans({}, 'design_system') }}</summary>
                        <div class="app-accordion-body">{{ 'styleguide.accordion.body'|trans({}, 'design_system') }}</div>
                    </details>
                    <details class="app-accordion" name="sg-accordion">
                        <summary>{{ 'styleguide.accordion.two'|trans({}, 'design_system') }}</summary>
                        <div class="app-accordion-body">{{ 'styleguide.accordion.body'|trans({}, 'design_system') }}</div>
                    </details>
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="topbar">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.topbar'|trans({}, 'design_system') }}</h2>
                <span class="app-muted">{{ 'styleguide.topbar.hint'|trans({}, 'design_system') }}</span>
            </div>
            <div class="app-sg-demo">
                <div class="app-row">
                    {# Une liste qui peut être longue : la tête ne défile pas, le corps si. La
                       pastille dit qu'il y a du nouveau, sans dire combien. #}
                    <details class="app-menu" data-controller="menu">
                        <summary class="app-btn" data-variant="subtle" data-icon
                                 aria-label="{{ 'styleguide.topbar.notifications'|trans({}, 'design_system') }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 9a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6M10 20a2 2 0 0 0 4 0"
                                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            <span class="app-dot" data-tone="danger"></span>
                        </summary>
                        <div class="app-menu-panel">
                            <div class="app-menu-head">
                                <strong>{{ 'styleguide.topbar.notifications'|trans({}, 'design_system') }}</strong>
                                <button type="button" class="app-btn" data-variant="ghost" data-size="sm">
                                    {{ 'styleguide.topbar.mark_all'|trans({}, 'design_system') }}
                                </button>
                            </div>
                            <div class="app-menu-body">
                                <ul class="app-list">
                                    {% for entry in ['one', 'two', 'three'] %}
                                        <li class="app-list-item">
                                            <div>
                                                <p class="app-list-title">{{ ('styleguide.list.' ~ entry)|trans({}, 'design_system') }}</p>
                                                <p class="app-list-meta">{{ 'styleguide.topbar.note'|trans({}, 'design_system') }}</p>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </details>

                    {# Une grille plutôt qu'une liste : le panneau prend la largeur qu'il faut. #}
                    <details class="app-menu" data-controller="menu">
                        <summary class="app-btn" data-variant="subtle" data-icon
                                 aria-label="{{ 'styleguide.topbar.apps'|trans({}, 'design_system') }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"
                                      fill="none" stroke="currentColor" stroke-width="2"/>
                            </svg>
                        </summary>
                        <div class="app-menu-panel" data-size="lg">
                            <div class="app-grid" data-cols="4">
                                {% for entry in ['overview', 'files', 'settings'] %}
                                    <a class="app-menu-item" href="#topbar">{{ ('styleguide.nav.' ~ entry)|trans({}, 'design_system') }}</a>
                                {% endfor %}
                            </div>
                        </div>
                    </details>

                    {# Le compte : une tête qui dit qui est connecté, puis ce qu'on peut faire. #}
                    <details class="app-menu" data-controller="menu">
                        <summary class="app-avatar" aria-label="{{ 'styleguide.topbar.account'|trans({}, 'design_system') }}">AM</summary>
                        <div class="app-menu-panel">
                            <div class="app-menu-head">
                                <span class="app-avatar">AM</span>
                                <div>
                                    <p class="app-list-title">{{ 'styleguide.topbar.account'|trans({}, 'design_system') }}</p>
                                    <p class="app-list-meta">{{ 'styleguide.topbar.email'|trans({}, 'design_system') }}</p>
                                </div>
                            </div>
                            <a class="app-menu-item" href="#topbar">{{ 'styleguide.menu.profile'|trans({}, 'design_system') }}</a>
                            <a class="app-menu-item" href="#topbar">{{ 'styleguide.menu.settings'|trans({}, 'design_system') }}</a>
                            <hr class="app-menu-separator">
                            <button type="button" class="app-menu-item" data-tone="danger">{{ 'styleguide.menu.logout'|trans({}, 'design_system') }}</button>
                        </div>
                    </details>

                    {# Le même menu, mais posé en bas d'un écran : il ouvre vers le haut. #}
                    <details class="app-menu" data-controller="menu" data-drop="up" data-align="start">
                        <summary class="app-btn" data-variant="subtle" data-size="sm">
                            {{ 'styleguide.topbar.upward'|trans({}, 'design_system') }}
                        </summary>
                        <div class="app-menu-panel">
                            <a class="app-menu-item" href="#topbar">{{ 'styleguide.menu.profile'|trans({}, 'design_system') }}</a>
                            <button type="button" class="app-menu-item" data-tone="danger">{{ 'styleguide.menu.logout'|trans({}, 'design_system') }}</button>
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <section class="app-sg-section" id="modal">
            <div class="app-section-title">
                <h2>{{ 'styleguide.section.modal'|trans({}, 'design_system') }}</h2>
            </div>
            <div class="app-sg-demo" data-controller="dialog">
                <button type="button" class="app-btn" data-action="dialog#open">{{ 'styleguide.modal.open'|trans({}, 'design_system') }}</button>
                <dialog class="app-modal" data-dialog-target="dialog" aria-labelledby="sg-modal-title">
                    <div class="app-modal-header">
                        <h3 id="sg-modal-title">{{ 'styleguide.modal.title'|trans({}, 'design_system') }}</h3>
                        <button type="button" class="app-btn" data-variant="ghost" data-size="sm" data-icon
                                data-action="dialog#close" aria-label="{{ 'action.close'|trans({}, 'design_system') }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                    <p>{{ 'styleguide.modal.body'|trans({}, 'design_system') }}</p>
                    <div class="app-modal-footer">
                        <button type="button" class="app-btn" data-variant="ghost" data-action="dialog#close">{{ 'action.cancel'|trans({}, 'design_system') }}</button>
                        <button type="button" class="app-btn" data-tone="danger" data-action="dialog#close">{{ 'action.confirm'|trans({}, 'design_system') }}</button>
                    </div>
                </dialog>
            </div>
        </section>
    </div>
{% endblock %}
