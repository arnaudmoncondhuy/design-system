# Dépendances installées par Composer. Un paquet ne fige pas les siennes : c'est
# l'application qui l'installe qui arbitre les versions.
/vendor/
/composer.lock

# Caches des outils qualité.
/var/
/.php-cs-fixer.cache
/qa/__pycache__/

# Binaire téléchargé par qa/install-gitleaks.sh — jamais versionné, version épinglée dans
# le script qui l'installe.
/qa/bin/
